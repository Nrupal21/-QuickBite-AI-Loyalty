# ============================================================
# QuickBite AI + Loyalty — Environment Variables
# ============================================================
# Copy this file to .env and fill in all values.
# Missing REQUIRED values = app will NOT start.
# See Doc 2 §4 for full details.
# ============================================================

# --- Core Application (REQUIRED) ---
SECRET_KEY=changeme-generate-64-hex-chars-minimum
CUSTOMER_SECRET_KEY=changeme-generate-64-hex-chars-different-from-above
ENVIRONMENT=local
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database & Cache (REQUIRED) ---
DATABASE_URL=postgresql+asyncpg://quickbite:quickbite@localhost:5432/quickbite
REDIS_URL=redis://localhost:6379/0

# --- Auth & Security ---
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=12
TOTP_ISSUER_NAME=QuickBite AI
ENCRYPTION_KEY_V1=  # python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Customer OTP Auth ---
CUSTOMER_JWT_TTL_DAYS=7
CUSTOMER_OTP_TTL_SECONDS=300
CUSTOMER_OTP_MAX_ATTEMPTS=3
CUSTOMER_OTP_RATE_LIMIT_SECONDS=120
CUSTOMER_OTP_DAILY_MAX=5
CUSTOMER_OTP_SMS_TEMPLATE=Your QuickBite code: {otp}

# --- AI Providers ---
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=your-gemini-api-key
AI_PROVIDER=auto

# --- Twilio (SMS + WhatsApp) ---
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=+1234567890

# --- SendGrid (Email) ---
SENDGRID_API_KEY=your-sendgrid-api-key

# --- Stripe (Billing) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- Stitch.ai (Frontend Generation) ---
STITCH_AI_API_KEY=your-stitch-ai-api-key
STITCH_AI_DESIGN_SYSTEM=quickbite_v1

# --- Cloudflare R2 (Object Storage) ---
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=quickbite-assets

# --- PostGIS ---
POSTGIS_ENABLED=true

# --- Sentry (Error Tracking — staging/prod only) ---
SENTRY_DSN=
