# ============================================================
# QuickBite AI + Loyalty — Environment Variables
# ============================================================
# Copy this file to .env and fill in all values.
# Missing REQUIRED values = app will NOT start.
# See Doc 2 §4 for full details.
# ============================================================

# --- Core Application (REQUIRED) ---
SECRET_KEY=changeme-generate-64-hex-chars-minimum
CUSTOMER_SECRET_KEY=changeme-generate-64-hex-chars-different-from-above
ENVIRONMENT=local
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database & Cache (REQUIRED) ---
# The app MUST NOT connect as a superuser or as the table owner. Postgres
# exempts superusers and BYPASSRLS roles from row-level security
# unconditionally, and exempts the table owner unless the table is FORCEd
# (migration 0006). Connecting as `postgres` therefore disables every tenant
# isolation policy in the database — silently, because RLS filters rather than
# errors, so an exempt connection looks identical to a correctly-scoped one.
# Run scripts/create_app_role.py to provision quickbite_app, then use it here.
# Keep the owner DSN for running `alembic upgrade` only.
DATABASE_URL=postgresql+asyncpg://quickbite_app:quickbite@localhost:5432/quickbite
# Alembic only. quickbite_app has no DDL rights on purpose, so migrations run
# as the owner. Leave empty to use DATABASE_URL for both.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quickbite
REDIS_URL=redis://localhost:6379/0

# --- Auth & Security ---
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=12
TOTP_ISSUER_NAME=QuickBite AI
ENCRYPTION_KEY_V1=  # python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Customer OTP Auth ---
CUSTOMER_JWT_TTL_DAYS=7
CUSTOMER_OTP_TTL_SECONDS=300
CUSTOMER_OTP_MAX_ATTEMPTS=3
CUSTOMER_OTP_RATE_LIMIT_SECONDS=120
CUSTOMER_OTP_DAILY_MAX=5
CUSTOMER_OTP_SMS_TEMPLATE=Your QuickBite code: {otp}

# --- AI Providers ---
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro
AI_PROVIDER=auto
# Per-provider budget, not the end-to-end one. REVIEW-01 allows 3s for an
# uncached draft; this must leave room for an OpenAI timeout PLUS a full
# Gemini attempt inside that window.
AI_REQUEST_TIMEOUT_SECONDS=1.2
AI_MAX_OUTPUT_TOKENS=220
AI_DRAFT_CACHE_TTL_SECONDS=3600

# --- Twilio (SMS + WhatsApp) ---
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=+1234567890

# --- Email (SMTP) ---
# Gmail requires an APP PASSWORD, not your account password:
#   1. Turn on 2-Step Verification for the Google account
#   2. Visit https://myaccount.google.com/apppasswords and generate one
#   3. Paste the 16 characters below (the spaces Google shows are stripped
#      automatically — pasting them verbatim causes a 535 5.7.8 error)
# Google removed "less secure app access" in May 2022, so a plain account
# password will ALWAYS fail. Workspace admins can disable App Passwords
# org-wide; if yours has, OAuth2/XOAUTH2 is the only path and this config
# will not work.
#
# SMTP_SECURITY: port 587 -> starttls, port 465 -> tls.
# Gmail rewrites the From header to SMTP_USERNAME unless EMAIL_FROM_ADDRESS is
# verified under Gmail Settings > Accounts > "Send mail as".
# Sending limits: free @gmail.com ~500 recipients/day, Workspace ~2000/day.
# Sustained bursts trigger a temporary 421 4.7.0 block for up to 24h — Gmail
# is suitable for dev and low-volume transactional mail, not bulk campaigns.
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=no-reply@quickbite.ai
EMAIL_FROM_NAME=QuickBite AI
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10

# --- SendGrid (Email — legacy, only used when EMAIL_PROVIDER=sendgrid) ---
SENDGRID_API_KEY=your-sendgrid-api-key

# --- Razorpay (Billing) ---
# RAZORPAY_WEBHOOK_SECRET is set per-webhook under Dashboard > Settings >
# Webhooks. It is a DIFFERENT value from RAZORPAY_KEY_SECRET — using the API
# key secret here makes every webhook fail signature verification with a 401.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- Supabase Auth (external identity provider) ---
# SUPABASE_PROJECT_REF is the bare ref only — the "abcdefghijklmnop" in
# https://abcdefghijklmnop.supabase.co, NOT the full URL. Leave it empty to
# disable Supabase token verification entirely.
# Tokens must be signed with an asymmetric key (ES256/RS256): enable JWT
# Signing Keys under Dashboard > Settings > API. Legacy HS256 shared-secret
# projects are deliberately not supported.
# SUPABASE_SERVICE_ROLE_KEY is server-only — it bypasses RLS. Never expose it.
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWKS_TTL_SECONDS=600

# --- Firebase Auth + Firestore ---
# FIREBASE_SERVICE_ACCOUNT_JSON is the RAW JSON of the service account key,
# on one line (escape newlines inside private_key as \n). Not a file path.
#   python -c "import json;print(json.dumps(json.load(open('sa.json'))))"
# Leave FIREBASE_PROJECT_ID empty to disable Firebase verification entirely.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIRESTORE_DATABASE=(default)
FIRESTORE_PROJECTION_ENABLED=true

# --- Firebase Web SDK (client-side — powers the login page's social buttons) ---
# NOT secrets: this is the public config Firebase's own docs say to embed in
# the browser (Project settings > General > Your apps > Web app). Restrict
# which domains it will actually run on under Authentication > Settings >
# Authorized domains — that is the real security boundary, not secrecy.
# Leave any of these empty to hide the social sign-in buttons entirely.
# Each provider (Google, Apple, Microsoft, GitHub, Twitter/X) must ALSO be
# individually enabled under Authentication > Sign-in method in the Firebase
# console before its button will work.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_WEB_APP_ID=

# --- External identity linking ---
# When false (default), an external token with no identity_links row is
# rejected with IDENTITY_LINK_REQUIRED. Staff accounts are NEVER auto-created
# regardless of this flag — only customers can be provisioned just-in-time.
EXTERNAL_AUTH_JIT_ENABLED=false

# --- Stitch.ai (Frontend Generation) ---
STITCH_AI_API_KEY=your-stitch-ai-api-key
STITCH_AI_DESIGN_SYSTEM=quickbite_v1

# --- Cloudflare R2 (Object Storage) ---
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=quickbite-assets

# --- PostGIS ---
POSTGIS_ENABLED=true

# --- Sentry (Error Tracking — staging/prod only) ---
SENTRY_DSN=

# Set true when DATABASE_URL uses a transaction pooler (Supabase port 6543).
# Disables asyncpg's prepared-statement cache, which the pooler invalidates
# between transactions. See Doc/SUPABASE_FIREBASE_SETUP.md.
DB_USE_TRANSACTION_POOLER=false
